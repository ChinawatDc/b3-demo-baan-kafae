---
import '../styles/global.css';
import { site } from '../data/site';
const url = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#E9DCC6" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <p class="sticky top-0 z-30 bg-ink px-4 py-1.5 text-center text-sm font-semibold text-cream" role="note">{site.banner}</p>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-20 focus:rounded focus:bg-white focus:p-2">ข้ามไปเนื้อหาหลัก</a>
    <slot />
  </body>
</html>
