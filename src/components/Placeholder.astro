---
// Box for the client's REAL photo. In the demo it shows DESIGNER's line drawing (no stock images).
import { ill } from '../data/illustrations';
interface Props { label: string; class?: string; src?: string }
const { label, class: cls = '', src } = Astro.props;
---
{src ? (
  <div class:list={['overflow-hidden rounded-[10px] bg-ph', cls]}>
    <img src={`/illustrations/${src}.svg`} alt={ill[src] || label} class="h-full w-full object-cover" loading={src === 'hero' ? 'eager' : 'lazy'} decoding="async" />
  </div>
) : (
  <div class:list={['ph', cls]} role="img" aria-label={`ตำแหน่งรูป: ${label}`}>[{label}]</div>
)}
