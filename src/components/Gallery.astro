---
import { gallery } from '../data/site';
import Placeholder from './Placeholder.astro';
const [first, ...rest] = gallery.photos;
---
<section id="gallery" class="py-14 md:py-20" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="text-center">
      <p class="eyebrow">{gallery.eyebrow}</p>
      <h2 id="gallery-title" class="h2">{gallery.title}</h2>
    </div>
    <div class="mt-9 grid grid-cols-2 grid-rows-[160px_120px_120px] gap-3.5 md:grid-cols-[2fr_1fr_1fr] md:grid-rows-[200px_200px]">
      <Placeholder label={first} class="col-span-2 md:col-span-1 md:row-span-2" />
      {rest.map((p) => <Placeholder label={p} />)}
    </div>
  </div>
</section>
